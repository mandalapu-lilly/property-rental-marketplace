# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Standard MongoDB connection string with credentials placeholder
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/property_marketplace?retryWrites=true&w=majority

# Optional separate fallback fields if URI is not provided
# MONGODB_USERNAME=your_db_username
# MONGODB_PASSWORD=your_db_password
# MONGODB_CLUSTER=cluster0.mongodb.net

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_change_in_production

# Frontend Client URL (for CORS allowance)
FRONTEND_URL=https://your-frontend-domain.vercel.app

